// soopdoop.com: static files only (no Worker code), so every request is served from Cloudflare's edge for free.
// `bun run deploy` builds dist/ and uploads it; the custom domains get their DNS records and certificates on deploy.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "soopdoop-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "soopdoop.com", "custom_domain": true },
    { "pattern": "www.soopdoop.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
