{
  "name": "soopdoop",
  "private": true,
  "version": "0.0.1",
  "description": "soopdoop: a multiplayer layer on top of Superset. Your Superset, with your crew in it.",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "convex": "bun --cwd packages/convex dev",
    "daemon": "bun --cwd apps/daemon dev",
    "rail": "bun --cwd apps/rail dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
