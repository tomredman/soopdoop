{
  "name": "soopdoop",
  "private": true,
  "version": "0.2.3",
  "description": "soopdoop: a multiplayer layer on top of Superset. Your Superset, with your crew in it.",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "convex": "bun --cwd packages/convex dev",
    "daemon": "bun --cwd apps/daemon dev",
    "rail": "bun --cwd apps/rail dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts --noEmit",
    "lint": "bun run --filter '*' lint",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
